/* =========================================================
   NOXCORE — ESTILOS BASE (Compatibles con Tailwind)
   ========================================================= */

/* ===== LAYOUT GENERAL ===== */
body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: #f2f4f8;
  margin: 0;
  color: #111827;
}

/* ===== CONTENEDORES ===== */
.card {
  background: #ffffff;
  border: 1px solid #d0d5dd;
  border-radius: 12px;
  padding: 1.25rem;
  box-shadow: 0 1px 2px rgba(0,0,0,0.06);
}

.card-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #1d4ed8;
  margin-bottom: 0.75rem;
}

/* ===== INPUTS ===== */
.input {
  width: 100%;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 0.95rem;
  box-sizing: border-box;
}

.input:focus {
  border-color: #2563eb;
  outline: none;
  box-shadow: 0 0 0 1px #2563eb;
}

/* ===== BOTONES ===== */
button { cursor: pointer; }

.btn-blue {
  background: #2563eb;
  color: white;
  padding: 8px 16px;
  font-weight: 500;
  border: none;
  border-radius: 8px;
}
.btn-blue:hover { background: #1e40af; }

.btn-green {
  background: #059669;
  color: white;
  padding: 8px 16px;
  font-weight: 500;
  border: none;
  border-radius: 8px;
}
.btn-green:hover { background: #047857; }

.btn-ghost {
  background: #f1f5f9;
  color: #1e293b;
  border: 1px solid #cbd5e1;
  padding: 8px 16px;
  border-radius: 8px;
}
.btn-ghost:hover { background: #e2e8f0; }

/* ===== TABLAS ===== */
.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}
.table th {
  background: #eff6ff;
  border: 1px solid #cbd5e1;
  padding: 0.65rem;
  color: #1e3a8a;
  font-weight: 600;
}
.table td {
  border: 1px solid #cbd5e1;
  padding: 0.65rem;
  background: #ffffff;
}

/* ===== TABS ===== */
.tab-btn {
  background: #e0f2fe;
  color: #1e40af;
  padding: 8px 16px;
  border: 1px solid #cbd5e1;
  border-bottom: 0;
  border-radius: 8px 8px 0 0;
  font-weight: 500;
  cursor: pointer;
}
.tab-active {
  background: #ffffff;
  color: #1e3a8a;
  border-bottom: 1px solid #ffffff;
}
.tab-content.hidden { display: none; }

/* ===== MODAL ===== */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.modal-box {
  background: #ffffff;
  border-radius: 12px;
  padding: 1.5rem;
  width: 100%;
  max-width: 22rem;
  box-shadow: 0 6px 14px rgba(0,0,0,0.18);
}
#modalPass.hidden { display: none; }
#modalPass.active { display: flex !important; }

/* =========================================================
   ⚠️ NO tocar clases Tailwind (.grid, .flex, etc.)
   ========================================================= */

/* ===== CONTENEDOR GENERAL ===== */
/* ===== CONTENEDOR GENERAL — ANCHO EXTENDIDO ===== */
.traslados-container,
.main-wrapper {
  max-width: 75vw !important;   /* casi todo el ancho */
  margin: 0 auto;
  padding: 0 25px;               /* margen suave a los lados */
}


/* ===== BUTTON TABS EXTRA ===== */
.tab-btn {
  padding: 6px 18px;
  font-size: 0.95rem;
  border-radius: 8px;
  background: #e0f2fe;
  border: 1px solid #cbd5e1;
}
.tab-btn:hover {
  background: #d0e9fc;
}
.tab-active {
  background: #ffffff !important;
  border-bottom: 1px solid #ffffff !important;
  color: #1d4ed8;
  font-weight: 600;
}

/* =========================================================
   TOAST NOXCORE
   ========================================================= */
.nox-toast {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 9999;
}

/* =========================================================
   SELECTS — evitar cortes
   ========================================================= */
select:not(.folio-select),
.select-traslado {
  min-width: 110px;
  white-space: nowrap;
}


.select-traslado-chofer { min-width: 90px; }
.select-traslado-dias { min-width: 95px; }

/* =========================================================
   TARJETAS DE CHOFER — GRILLA RESPONSIVA
   ========================================================= */
#statsChoferCards {
  display: grid !important;
  gap: 18px !important;
  grid-template-columns: repeat(4, minmax(180px, 1fr)) !important;
  margin-top: 14px;
}

.chofer-card {
  background: #ffffff;
  border: 1px solid #d0d5dd;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

#loadingSpinner {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 6px;
    background: transparent;
    color: #1d4ed8;
    font-weight: 600;
    font-size: 0.9rem;
}

#loadingSpinner.hidden {
    display: none !important;
}

.nox-spinner {
    width: 18px;
    height: 18px;
    border: 3px solid rgba(29,78,216,0.3);
    border-top-color: #1d4ed8;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

#loadingSpinner.hidden {
    display: none !important;
}

/* Botón modo NOX dentro del menú — NO TAB */
.btn-nox {
    background: #1e3a8a;
    color: white;
    padding: 8px 18px;
    border: 1px solid #1e3a8a;
    border-radius: 8px;
    font-weight: 500;
    transition: background 0.3s ease, color 0.3s ease, border 0.3s;
}

.btn-nox:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
}

/* Cuando está activo en modo NOX */
body.noxmode .btn-nox {
    background: #0ea5e9;
    border-color: #0ea5e9;
    color: #000;
}

/* =========================================================
   FIX NAV SUPERIOR (TABS + BOTÓN MODO NOX)
   ========================================================= */

/* Contenedor general del nav */
.nav-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0px;   /* separa tabs del botón */
    margin-bottom: 0px;
}

/* Estilo base de tabs (modo claro) */
.tab-btn {
    background: #e0f2fe;
    color: #1e40af;
    padding: 8px 20px;
    border: 1px solid #cbd5e1;
    border-bottom: 0px;
    border-radius: 10px 10px 0 0;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
}

.tab-btn:hover {
    background: #d3ecff;
}

/* Tab activa */
.tab-active {
    background: #ffffff !important;
    color: #1d4ed8 !important;
    border-bottom: 1px solid #ffffff !important;
    font-weight: 600;
    box-shadow: 0 0 12px rgba(0, 115, 255, 0.25);
}

/* Botón Modo Nox */
#modoNoxBtn {
    background: #1e3a8a;
    color: #ffffff;
    padding: 8px 20px;
